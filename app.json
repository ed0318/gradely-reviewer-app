{
  "expo": {
    "name": "Gradely Reviewer",
    "slug": "gradely-reviewer",
    "scheme": "gradely-reviewer",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gradely.reviewer",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123A63",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ph.gradely.reviewer",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE",
        "android.permission.ACCESS_ADSERVICES_TOPICS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#123A63"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/zilla-slab/600SemiBold/ZillaSlab_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/zilla-slab/700Bold/ZillaSlab_700Bold.ttf",
            "./node_modules/@expo-google-fonts/public-sans/400Regular/PublicSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/public-sans/400Regular_Italic/PublicSans_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/public-sans/500Medium/PublicSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/public-sans/600SemiBold/PublicSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/public-sans/700Bold/PublicSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/600SemiBold/JetBrainsMono_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/kalam/400Regular/Kalam_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gradely Reviewer uses your photos so you can set a profile picture.",
          "cameraPermission": "Gradely Reviewer uses the camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-native.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
