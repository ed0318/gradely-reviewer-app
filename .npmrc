# EAS Build runs a clean `npm install`, which stops on a peer conflict that npm
# can otherwise be told to ignore. react-dom resolves to 19.3.0 (an optional
# peer of expo, for web) and demands react ^19.3.0, while this project pins the
# react 19.2.3 that React Native 0.86 is built against. Nothing here imports
# react-dom; the conflict is between two packages the app never renders through.
legacy-peer-deps=true
