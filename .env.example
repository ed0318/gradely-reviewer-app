# Copy to .env and fill in. Restart Metro after any change: EXPO_PUBLIC_ values
# are inlined at bundle time, and anyone with the app can read them. Nothing
# secret goes here. The only credential the app holds is the user's own token,
# kept in SecureStore.

# The reviewer API. No trailing slash. The Android emulator reaches the host
# machine at 10.0.2.2, a real phone at your LAN IP. Left unset, the app runs
# local-only and signing in reports that no server is connected.
EXPO_PUBLIC_API_URL=http://localhost:8100/v1

# Google sign-in: public client ids. The WEB client id must match the server's
# GOOGLE_SIGNIN_CLIENT_IDS. The iOS one (bundle id ph.gradely.reviewer) becomes
# the google-signin plugin's iosUrlScheme in app.config.js.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat PUBLIC SDK keys only: appl_… (iOS), goog_… (Android). Never an
# sk_ secret key; that lives on the API server. app.config.js refuses a
# production build that carries one.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
